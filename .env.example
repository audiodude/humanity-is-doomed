# Copy to .env and point these at your IWADs. Variables set in the
# environment override this file.
#
# DOOM2_WAD: textures for the builder's checks and measurements, and the
# playtests. DOOM_WAD: Ultimate Doom, for the research scripts. The research
# numbers come from the v1.9 IWADs, such as the Steam "Ultimate Doom" ones:
DOOM_WAD="~/.local/share/Steam/steamapps/common/Ultimate Doom/base/DOOM.WAD"
DOOM2_WAD="~/.local/share/Steam/steamapps/common/Ultimate Doom/base/doom2/DOOM2.WAD"
#
# DOOM_STEAM_BASE: that Steam install's base/ directory, for the research
# scripts' --set runs over TNT, Plutonia and the Master Levels:
DOOM_STEAM_BASE="~/.local/share/Steam/steamapps/common/Ultimate Doom/base"
