# Nukage Drain (MAP05) wiring test: each pump raises its walkways, every
# closet, key door and secret, the loop back to the start, then the exit.
#   uv run --with vizdoom scripts/tools/playtest.py wads/NUKAGE.WAD MAP05 levels/playtests/nukage_drain.playtest

killall
shot start
expect floor -720 1200 == -16      # the walkways are under the nukage

# The radiation suit closet off the catwalk.
open -560 336
walk -560 272
expect has PowerIronFeet

# Wading: the chaingun and the soulsphere in the nukage, then the secret ledge
# on the pillar's north face.
walk 400 700
expect has Chaingun
walk -560 1464
walk -96 1288
expect secrets == 1
expect has BasicArmor

# West pump house: the corridor and its secret.
open -816 432
open -1024 352
walk -1024 280
expect secrets == 2
open -1024 336

# The super shotgun opens the pump hall's closets.
walk -1024 864
expect has SuperShotgun
wait 70
expect ceil -1416 784 > 100
expect ceil -1416 1040 > 100

# Pump 1: the west walkway rises out of the nukage.
walk -990 976
expect ceil -280 1088 == 32       # the closet stays shut until you step into the booth
walk -880 976
wait 70
expect ceil -280 1088 > 100        # stepping into the booth opened the pillar's west closet
use -832 976
walk -860 1088
look 0
wait 40
shot pump1
wait 90
expect floor -720 1200 == 32
checkpoint pump1

# Along the west walkway to the north pump house, and its lobby secret.
open -832 432
open -720 1712
open -864 1856
walk -950 1856
expect secrets == 3
open -880 1856

# North hall: the yellow key opens two closets; pump 2 raises the north walkway.
open -488 1856
walk 96 1984
expect has YellowCard
wait 70
expect ceil 520 1920 > 100
expect ceil 520 2144 > 100
walk 256 1900
expect ceil 96 1240 == 32
walk 256 1800
wait 70
expect ceil 96 1240 > 100          # and the north closet
use 256 1760
wait 130
expect floor 400 1620 == 32
checkpoint pump2

# Along the north walkway to the yellow door and the east boiler house and its secret.
open -472 1856
open -720 1728
open 816 1616
open 1184 1952
walk 1184 2030
expect secrets == 4
expect has Backpack
open 1184 1968
walk 1332 1580
expect has RocketLauncher

# Pump 3 raises the east walkway and the causeway to the vault.
open 1120 1504
walk 1000 1424
expect ceil 280 1176 == 32
walk 910 1424
wait 70
expect ceil 280 1176 > 100         # and the east closet
use 864 1424
walk 880 1328
look 180
wait 40
shot pump3
wait 90
expect floor 720 800 == 32
expect floor 400 1024 == 40       # up to the vault door's step
checkpoint pump3

# The east walkway closes a loop back to the start.
open 1120 1488
open 832 1616
walk 720 440
expect pos 720 440

# Onto the causeway: closets open behind you. Then the vault and the exit.
walk 720 1024
walk 600 1024
wait 70
expect ceil 808 704 > 100
expect ceil 808 1024 > 100
open 272 1024
walk -100 1024
shot vault
exit -136 1024
