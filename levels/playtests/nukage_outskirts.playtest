# Nukage Outskirts (MAP01) wiring test: the rubble heap, up the hillside's three
# shelves, round the station to the dock, the ring of station rooms and the blue key,
# the lobby shutter, the blue door and the reveal, down the cliff to the shore, the
# jetty and the exit, with all four secrets.
#   uv run -q --with vizdoom scripts/tools/playtest.py nukage_outskirts

killall
look 90 -10
shot start
expect ceil 1528 2048 == 288      # dock door shut
expect ceil 1024 1448 == 288      # front shutter shut
expect ceil 1384 2248 == 288      # storeroom closet shut
expect ceil 1152 3640 == 32       # intake-house closet shut

# The valley: the shotgun, the shells on top of the rubble heap, the guard hut and secret 1.
walk -96 224
expect has Shotgun
walk -288 192
walk -448 192
expect has Shell
walk -96 224
walk 640 160
look 270
shot guard-hut-door
open 640 -16
walk 640 -128
walk 704 -256
open 512 -176
walk 432 -176
expect secrets == 1
expect has BasicArmor
walk 640 -128
walk 640 160

# Shelf 1 east to the hairpin, the spur and secret 2: a rock door in the cliff above the container.
walk 128 512
walk 1152 512
look 0 -5
shot hairpin-ledge
walk 1376 544
walk 1440 576
walk 1536 560
look 90 -10
shot secret2-door
open 1536 640
walk 1536 560
look 90 -10
shot secret2-open
walk 1536 720
look 270 -20
shot secret2-inside
expect secrets == 2
walk 1440 576
walk 1152 512

# Shelf 2 west, shelf 3 east, onto the forecourt.
walk 1152 768
walk -128 768
walk -128 1024
walk 896 1024
walk 776 1300
look 90 -5
shot forecourt-window
look 90 -30
shot forecourt-ridge              # nothing over the ridge may show

# Round the station: the service ledge, the yard and the dock switch.
walk 1680 1472
walk 1680 1600
walk 1900 1800
walk 1744 2048
walk 1632 1920
look 180
shot dock
use 1536 1920
wait 105
expect ceil 1528 2048 >= 412

# The storeroom, then the instrument room: the blue key opens the storeroom closet.
walk 1600 2048
walk 1480 2048
look 180
shot storeroom
open 1248 2048
walk 1180 2048
look 180 25
shot instrument-room
walk 1056 2016
expect has BlueCard
wait 70
expect ceil 1384 2248 > 288

# The ring: the lobby, the dark generator room, the storeroom and its open closet.
open 1080 1856
walk 1080 1760
look 270 10
shot lobby
open 1200 1648
walk 1368 1648
open 1384 1840
walk 1384 1920
walk 1300 2160
walk 1384 2320
look 270 10
shot closet
walk 1300 2160
walk 1384 1920
open 1384 1856
walk 1368 1648
open 1216 1648
walk 960 1520

# The lobby's shutter switch opens the front shutter onto the forecourt: the loop.
use 912 1456
wait 70
expect ceil 1024 1448 > 288
walk 1024 1380
walk 1024 1520

# The locker room and secret 3.
open 520 1840
walk 520 1920
walk 480 2048
open 400 2048
walk 320 2048
expect secrets == 3
expect has Backpack
walk 520 2048
walk 520 1920
open 520 1856
walk 784 1780

# The stair hall and the blue door: the reveal.
walk 784 2160
open 784 2224
walk 900 2400
look 90 5
shot deck-reveal
look 45 15
shot deck-island

# Down the cliff stair; the lift down to the shore, and back up from it.
walk 400 2380
walk -32 2400
walk -64 2560
wait 50
expect floor -64 2560 == 16
walk 300 2560
wait 140
expect floor -64 2560 == 192
use 0 2560
wait 50
expect floor -64 2560 == 16

# The pump shed: secret 4 is a shifted panel whose switch lowers the island into the spill. Then across the nukage.
expect floor 1696 3168 == 96
open 2304 2624
walk 2304 2512
open 2312 2432
walk 2312 2376
expect secrets == 4
use 2312 2336
wait 140
expect floor 1696 3168 == 0
walk 2312 2512
walk 1700 2720
walk 1696 3168
expect has Soulsphere
walk 1700 2720

# The jetty: its root opens the intake-house closet. The exit.
walk 1152 2740
look 90
shot jetty
walk 1152 2840
wait 70
expect ceil 1152 3640 > 32
walk 1152 3340
look 90
shot intake-house
walk 1260 3520
look 90
shot exit
exit 1280 3640
